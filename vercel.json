{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run vercel-build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "artifacts/comix-web/dist/public/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
